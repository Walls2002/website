{
  // Static site served from Cloudflare Workers static assets (no Worker script needed).
  // Build first with `npm run build`, which writes the export to ./out.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kin-kitchen",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": "./out",
    // Serve out/404.html with a 404 status for unknown paths.
    "not_found_handling": "404-page",
    // /about serves out/about.html, matching Next's export file names.
    "html_handling": "auto-trailing-slash"
  }
}
