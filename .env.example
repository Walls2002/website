# Public origin of the deployed site (canonical URLs, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://kin-kitchen.pages.dev

# Where sent orders go: the Kin Kitchen CRM. Same Supabase project URL and publishable key as the
# CRM's .env.local (public by design, they ship in the browser bundle). The CRM emails the owner
# through Brevo when an order is saved, so there is no email key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Without these the order form still works: it hands the customer a ready-made email to send.
