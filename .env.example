# Public origin of the deployed site (canonical URLs, sitemap, robots).
NEXT_PUBLIC_SITE_URL=https://kin-kitchen.pages.dev

# Where sent orders go. Every value here is public by design (they ship in the browser bundle).
# 1) The Kin Kitchen CRM: same Supabase project URL and publishable key as the CRM's .env.local.
#    Run the CRM migration 0010_web_orders.sql first; it adds the submit_web_order RPC this calls.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 2) Email to the owner: create a free access key at https://web3forms.com with kinkitchen4@gmail.com.
NEXT_PUBLIC_WEB3FORMS_KEY=

# With none of these set, the order form still works: it hands the customer a ready-made email to send.
